# Grok / Groq API Configuration
# Option 1: Groq API (Permanently free tier fast LPU inference)
# Endpoint: https://api.groq.com/openai/v1/chat/completions
# Model: llama-3.3-70b-versatile
VITE_GROK_API_KEY=your_groq_api_key_here
VITE_GROK_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
VITE_GROK_API_MODEL=llama-3.3-70b-versatile

# Option 2: xAI Grok API
# VITE_GROK_API_KEY=your_xai_api_key_here
# VITE_GROK_API_ENDPOINT=https://api.x.ai/v1/chat/completions
